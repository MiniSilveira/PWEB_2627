  "components": {
    "schemas": {
      "AtualizarCategoriaDto": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "ordem": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "imagem": {
            "type": "string",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Os dados necessários para alterar uma categoria existente. O id viaja no URL."
      },
      "AtualizarModoDisponibilizacaoDto": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AtualizarProdutoDto": {
        "required": [
          "categoriaId",
          "nome",
          "precoBase"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "detalhe": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "precoBase": {
            "maximum": 99999999,99,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "disponibilidade": {
            "maximum": 9999999,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "visivel": {
            "type": "boolean"
          },
          "categoriaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "modoDisponibilizacaoId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "imagem": {
            "type": "string",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CategoriaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "ordem": {
            "type": "integer",
            "format": "int32"
          },
          "imagem": {
            "type": "string",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CriarCategoriaDto": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "O nome da categoria. Máximo de 100 caracteres.",
            "example": "Aparthotéis"
          },
          "ordem": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer",
            "description": "A ordem de apresentação da categoria (0 a 1000).",
            "format": "int32",
            "example": 3
          },
          "imagem": {
            "type": "string",
            "description": "A imagem da categoria, codificada em formato Base64. Apenas PNG ou JPG, até 500KB. Null se não houver imagem.",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Os dados necessários para criar uma nova categoria."
      },
      "CriarModoDisponibilizacaoDto": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "O nome do modo. Máximo de 100 caracteres.",
            "example": "Meia-Pensão"
          }
        },
        "additionalProperties": false,
        "description": "Os dados para criar um modo de disponibilização (ex: Tudo Incluído)."
      },
      "CriarProdutoDto": {
        "required": [
          "categoriaId",
          "nome",
          "precoBase"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "detalhe": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "precoBase": {
            "maximum": 99999999,99,
            "minimum": 0,01,
            "type": "number",
            "description": "O preço base, maior do que zero, com duas casas decimais no máximo.",
            "format": "double",
            "example": 150
          },
          "disponibilidade": {
            "maximum": 9999999,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "visivel": {
            "type": "boolean"
          },
          "categoriaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "A categoria do alojamento.",
            "format": "int32",
            "example": 1
          },
          "modoDisponibilizacaoId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "imagem": {
            "type": "string",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Os dados para criar um novo alojamento."
      },
      "ModoDisponibilizacaoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProdutoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          },
          "detalhe": {
            "type": "string",
            "nullable": true
          },
          "precoBase": {
            "type": "number",
            "format": "double"
          },
          "disponibilidade": {
            "type": "integer",
            "format": "int32"
          },
          "visivel": {
            "type": "boolean"
          },
          "categoria": {
            "$ref": "#/components/schemas/ReferenciaDto"
          },
          "modoDisponibilizacao": {
            "$ref": "#/components/schemas/ReferenciaDto"
          },
          "imagem": {
            "type": "string",
            "format": "byte",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReferenciaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nome": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
